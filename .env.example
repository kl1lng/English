# Optional. Without this key, speech feedback uses the honest local demo response.
OPENAI_API_KEY=
# Model used for short, age-appropriate written feedback after the student opts in.
OPENAI_COACH_MODEL=gpt-4o-mini
# Optional model for the Vercel chat function. Calls are billed by OpenAI.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional Cloudflare Workers AI credentials for speech transcription and feedback.
# Create an API token with Account > Workers AI > Read permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override; defaults to @cf/meta/llama-3.3-70b-instruct-fp8-fast.
CLOUDFLARE_FEEDBACK_MODEL=
PORT=3001
