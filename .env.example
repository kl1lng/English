# Optional. Without this key, speech feedback uses the honest local demo response.
OPENAI_API_KEY=
# Model used for short, age-appropriate written feedback after the student opts in.
OPENAI_COACH_MODEL=gpt-4o-mini
# Optional model for the Vercel chat function. Calls are billed by OpenAI.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional Cloudflare Workers AI credentials for speech transcription and feedback.
# Create an API token with Account > Workers AI > Read permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override; defaults to @cf/meta/llama-3.3-70b-instruct-fp8-fast.
CLOUDFLARE_FEEDBACK_MODEL=
# Optional free-tier Groq key (console.groq.com). When set, written feedback uses Groq
# instead of Cloudflare Llama; Whisper transcription still uses Cloudflare.
GROQ_API_KEY=
# Optional override; defaults to openai/gpt-oss-120b.
GROQ_FEEDBACK_MODEL=
PORT=3001

# Accounts and progress (public values, baked into the build).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional daily limits per learner (defaults in brackets). Counted in Supabase.
# DAILY_FEEDBACK_LIMIT=30  DAILY_CHAT_LIMIT=60
# DAILY_DIALOGUE_SESSIONS=5  DAILY_DIALOGUE_TURNS=30  DAILY_DIALOGUE_SUMMARIES=10
# Set to false to switch the speaking partner off without a deploy.
AI_DIALOGUE_ENABLED=

# Optional Telegram reminders (all server-side except the bot name). See the plan, phase 2.7.
VITE_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# Server-only key that lets the webhook and the reminder job write the link. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
